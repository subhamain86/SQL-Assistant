<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Azure App Service: serve the single-file app and keep it fresh after each release -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
    <staticContent>
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <httpProtocol><customHeaders>
      <add name="Cache-Control" value="no-cache" />
      <add name="X-Content-Type-Options" value="nosniff" />
    </customHeaders></httpProtocol>
  </system.webServer>
</configuration>
